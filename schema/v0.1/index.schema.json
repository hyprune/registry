{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyprune.com/schema/registry/v0.1/index.schema.json",
  "title": "Hyprune registry index 0.1 (RFC-0015): the document every index source serves; $defs.entry is one entry and the shape of a registry entry file",
  "type": "object",
  "properties": {
    "indexVersion": {
      "const": "0.1"
    },
    "name": {
      "type": "string",
      "$ref": "#/$defs/line",
      "maxLength": 64
    },
    "homepage": {
      "$ref": "#/$defs/https"
    },
    "serial": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generated": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,9})?Z$"
    },
    "successor": {
      "anyOf": [
        {
          "$ref": "#/$defs/https"
        },
        {
          "type": "null"
        }
      ]
    },
    "entries": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "indexVersion",
    "serial",
    "generated",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "description": "SemVer 2.0 without build metadata (published versions).",
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "tag": {
      "description": "The git tag the release was built from: v<version> or <name>-v<version>.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "formatVersion": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^0\\.(0|[1-9][0-9]*)$"
    },
    "license": {
      "description": "SPDX expression (parsed by the validator).",
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "https": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s/?#@]+(/[^\\s]*)?$"
    },
    "line": {
      "description": "One line of plain text: no control characters.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "libraryRef": {
      "description": "An exact library id@version (RFC-0011).",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "requires": {
      "type": "object",
      "properties": {
        "libraries": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/libraryRef"
          }
        }
      },
      "additionalProperties": false
    },
    "thumbnail": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/https"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1280
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      },
      "required": [
        "url",
        "sha256",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "version-entry": {
      "description": "One published version of an entry (versions[]).",
      "type": "object",
      "properties": {
        "tag": {
          "$ref": "#/$defs/tag"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "formatVersion": {
          "$ref": "#/$defs/formatVersion"
        },
        "published": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "url": {
          "$ref": "#/$defs/https"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "expandedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "record": {
          "type": "object",
          "properties": {
            "url": {
              "$ref": "#/$defs/https"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "url",
            "sha256"
          ],
          "additionalProperties": false
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "thumbnails": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/thumbnail"
          }
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        }
      },
      "required": [
        "tag",
        "version",
        "formatVersion",
        "published",
        "license",
        "url",
        "sha256",
        "bytes",
        "expandedBytes",
        "files"
      ],
      "additionalProperties": false
    },
    "entry": {
      "description": "One package of an index. A registry entry file is exactly one entry and may add a $schema pointer; entries inside an index carry none.",
      "type": "object",
      "properties": {
        "$schema": {
          "$ref": "#/$defs/https"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "description": "world and library are installable. extension is reserved for RFC-0007 process extensions: no extension host exists yet, so clients skip extension entries (never list or install them), and the official and community registries accept none.",
          "enum": [
            "world",
            "library",
            "extension"
          ]
        },
        "name": {
          "type": "string",
          "$ref": "#/$defs/line",
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "maxLength": 140,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "description": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^[^\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f]*$"
        },
        "creator": {
          "type": "string",
          "$ref": "#/$defs/line",
          "maxLength": 64
        },
        "repo": {
          "$ref": "#/$defs/https"
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/version-entry"
          }
        }
      },
      "required": [
        "id",
        "type",
        "name",
        "creator",
        "versions"
      ],
      "additionalProperties": false
    }
  }
}
